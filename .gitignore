# Virtual environments
.venv/
.venv-torchtext/
venv/
env/

# Environment variables / secrets
.env
.env.*

# Python cache
__pycache__/
*.py[cod]

# Jupyter
.ipynb_checkpoints/

# Large datasets (regenerated from Korpora; corpus.txt is >500MB, over GitHub's 100MB limit)
datasets/

# Training logs / experiment tracking
lightning_logs/
runs/
wandb/
mlruns/
*.log

# Editors
.idea/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Data and model files are tracked on purpose
!*.csv
!*.pt
!*.pth

# Downloaded pretrained weights (ultralytics auto-downloads these; must stay below !*.pt)
yolo*.pt

# Type-checker / linter / test caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
.dmypy.json

# Python build artifacts
build/
dist/
*.egg-info/

# Gensim Word2Vec artifacts (10MB+, regenerated by the training notebook; must stay below !*.pt)
models/word2vec.model
models/word2vec.model.*
*.npy

# Editors / tooling
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Fine-tuned Hugging Face transformer weights (240MB–710MB, over GitHub's 100MB limit; must stay below !*.pt)
models/BartForConditionalGeneration.pt
models/BertForSequenceClassification.pt
models/ElectraForSequenceClassification.pt
models/T5ForConditionalGeneration.pt
